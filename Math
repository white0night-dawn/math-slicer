<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Math Slicer - Webcam Hand Gesture Game</title>
    <!-- Tailwind CSS for UI styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- MediaPipe libraries for Hand Tracking -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
    
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: #111827; /* Tailwind gray-900 */
            overflow: hidden;
            font-family: 'Inter', sans-serif;
        }

        #game-container {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* Video element is used to process the webcam feed but is hidden visually, 
           we draw it to the canvas manually to apply mirroring and overlay easily */
        .input_video {
            display: none;
        }

        /* The main game canvas */
        .output_canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 10;
        }

        /* UI Overlay is above the canvas */
        #ui-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 20;
            pointer-events: none; /* Let clicks pass through to canvas if needed */
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Screens */
        .screen {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: rgba(17, 24, 39, 0.85); /* Dark overlay */
            z-index: 30;
            pointer-events: auto; /* Enable clicks on buttons */
            transition: opacity 0.3s;
        }
        
        .hidden {
            display: none !important;
        }
        
        /* Fun text effects */
        .text-glow {
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.5), 0 0 20px rgba(59, 130, 246, 0.8);
        }

        .floating {
            animation: float 3s ease-in-out infinite;
        }

        @keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
            100% { transform: translateY(0px); }
        }
    </style>
</head>
<body>

    <div id="game-container">
        <!-- Hidden Video Element for MediaPipe -->
        <video class="input_video" autoplay playsinline></video>
        
        <!-- Game Canvas -->
        <canvas class="output_canvas" id="gameCanvas"></canvas>

        <!-- Start Screen -->
        <div id="start-screen" class="screen">
            <h1 class="text-6xl font-black text-white mb-4 text-glow floating">MATH SLICER</h1>
            
            <div class="bg-gray-800/90 p-6 rounded-2xl border border-gray-600 mb-8 max-w-2xl text-left shadow-2xl backdrop-blur-md">
                <h3 class="text-2xl font-bold text-blue-400 mb-4 text-center border-b border-gray-600 pb-2 uppercase tracking-wider">How to Play</h3>
                <ul class="text-lg text-gray-200 space-y-3">
                    <li class="flex items-start"><span class="mr-3 text-2xl">🖐️</span> <span><strong>Pose:</strong> Ensure your hands are clearly visible to the webcam.</span></li>
                    <li class="flex items-start"><span class="mr-3 text-2xl">☝️</span> <span><strong>The Blade:</strong> Point your <strong>index finger</strong> to control the glowing sword.</span></li>
                    <li class="flex items-start"><span class="mr-3 text-2xl">🧮</span> <span><strong>Solve & Slice:</strong> Solve the math problem at the top and physically <strong>slice the correct bubble!</strong></span></li>
                    <li class="flex items-start"><span class="mr-3 text-2xl">❤️</span> <span><strong>3 Lives Mode:</strong> Lose a life if you slice a wrong answer or let a correct answer fly away.</span></li>
                    <li class="flex items-start"><span class="mr-3 text-2xl">⏱️</span> <span><strong>Time Limit Mode:</strong> Score as high as possible in 60s. Slicing a wrong answer costs 5 seconds!</span></li>
                </ul>
            </div>

            <div id="mode-selection" class="flex gap-4 mb-4">
                <button id="start-survival-btn" class="px-6 py-4 bg-blue-600 hover:bg-blue-500 text-white rounded-full font-bold text-xl shadow-lg hover:shadow-blue-500/50 transition-all transform hover:scale-105">
                    Play 3 Lives Mode
                </button>
                <button id="start-time-btn" class="px-6 py-4 bg-purple-600 hover:bg-purple-500 text-white rounded-full font-bold text-xl shadow-lg hover:shadow-purple-500/50 transition-all transform hover:scale-105">
                    Play 60s Time Limit
                </button>
            </div>
            <div id="loading-text" class="hidden mt-4 text-blue-300 font-semibold animate-pulse">
                Loading AI Models and Camera... Please wait.
            </div>
        </div>

        <!-- Game Over Screen -->
        <div id="game-over-screen" class="screen hidden">
            <h2 class="text-6xl font-black text-red-500 mb-4 text-glow">GAME OVER</h2>
            <p class="text-3xl text-white mb-2">Final Score: <span id="final-score" class="text-blue-400 font-bold">0</span></p>
            <p class="text-xl text-gray-400 mb-8">Great effort, Ninja!</p>
            <div id="restart-buttons" class="flex gap-4">
                <button id="restart-survival-btn" class="px-6 py-3 bg-green-600 hover:bg-green-500 text-white rounded-full font-bold text-xl shadow-lg hover:shadow-green-500/50 transition-all transform hover:scale-105">
                    Replay 3 Lives
                </button>
                <button id="restart-time-btn" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-full font-bold text-xl shadow-lg hover:shadow-indigo-500/50 transition-all transform hover:scale-105">
                    Replay Time Limit
                </button>
            </div>
        </div>

        <!-- HUD (Heads Up Display) -->
        <div id="ui-layer" class="hidden p-6">
            <div class="flex justify-between items-start">
                <div class="bg-gray-800/80 backdrop-blur-sm px-6 py-3 rounded-2xl border border-gray-700 shadow-lg">
                    <p class="text-gray-400 text-sm font-bold uppercase tracking-wider mb-1">Score</p>
                    <p id="score-display" class="text-4xl font-black text-blue-400">0</p>
                    <p id="combo-display" class="text-sm font-bold text-yellow-400 hidden mt-1">Combo x1</p>
                </div>
                <div class="bg-gray-800/80 backdrop-blur-sm px-6 py-3 rounded-2xl border border-gray-700 shadow-lg text-center">
                    <p class="text-gray-400 text-sm font-bold uppercase tracking-wider mb-1">Solve This!</p>
                    <p id="question-display" class="text-5xl font-black text-white text-glow">5 + 3</p>
                </div>
                <div class="bg-gray-800/80 backdrop-blur-sm px-6 py-3 rounded-2xl border border-gray-700 shadow-lg text-right">
                    <div id="lives-container">
                        <p class="text-gray-400 text-sm font-bold uppercase tracking-wider mb-1">Lives</p>
                        <div id="lives-display" class="flex gap-2 justify-end mt-2">
                            <!-- Hearts will be injected here -->
                        </div>
                    </div>
                    <div id="time-container" class="hidden">
                        <p class="text-gray-400 text-sm font-bold uppercase tracking-wider mb-1">Time Left</p>
                        <p id="time-display" class="text-4xl font-black text-purple-400 mt-1">60s</p>
                    </div>
                </div>
            </div>
            
            <div class="text-center pb-4 opacity-50">
                <p class="text-white font-medium bg-black/50 inline-block px-4 py-1 rounded-full">Use your index finger to slice!</p>
            </div>
        </div>
    </div>

    <script>
        // DOM Elements
        const videoElement = document.querySelector('.input_video');
        const canvasElement = document.getElementById('gameCanvas');
        const canvasCtx = canvasElement.getContext('2d');
        
        const startScreen = document.getElementById('start-screen');
        const gameOverScreen = document.getElementById('game-over-screen');
        const uiLayer = document.getElementById('ui-layer');
        const modeSelection = document.getElementById('mode-selection');
        const restartButtons = document.getElementById('restart-buttons');
        const startSurvivalBtn = document.getElementById('start-survival-btn');
        const startTimeBtn = document.getElementById('start-time-btn');
        const restartSurvivalBtn = document.getElementById('restart-survival-btn');
        const restartTimeBtn = document.getElementById('restart-time-btn');
        const loadingText = document.getElementById('loading-text');
        
        const scoreDisplay = document.getElementById('score-display');
        const comboDisplay = document.getElementById('combo-display');
        const finalScoreDisplay = document.getElementById('final-score');
        const questionDisplay = document.getElementById('question-display');
        const livesDisplay = document.getElementById('lives-display');
        const livesContainer = document.getElementById('lives-container');
        const timeContainer = document.getElementById('time-container');
        const timeDisplay = document.getElementById('time-display');

        // Game State
        let gameState = 'start'; // start, loading, playing, gameover
        let gameMode = 'survival'; // survival, time
        let score = 0;
        let lives = 3;
        let timeLeft = 60;
        let lastTick = 0;
        let animationFrameId;
        
        // Game Entities
        let bubbles = [];
        let particles = [];
        let floatingTexts = [];
        let currentQuestion = { text: '', answer: 0 };
        let combo = 0;
        let screenShake = 0;
        let audioCtx = null;
        
        // Hand Tracking Data
        let indexFingerPos = { x: -100, y: -100 }; // Current position
        let fingerTrail = []; // For the "sword slice" effect
        const MAX_TRAIL_LENGTH = 15;
        let lastVideoTime = 0;

        // Configuration
        const BUBBLE_SPAWN_RATE = 150; // frames between spawns
        let frameCounter = 0;
        let gameDifficulty = 1;

        function resizeCanvas() {
            // Fill window
            canvasElement.width = window.innerWidth;
            canvasElement.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function generateQuestion() {
            // Simple addition/subtraction for prototype
            const operators = ['+', '-'];
            const op = operators[Math.floor(Math.random() * operators.length)];
            let a, b;
            
            if (op === '+') {
                a = Math.floor(Math.random() * (10 * gameDifficulty)) + 1;
                b = Math.floor(Math.random() * (10 * gameDifficulty)) + 1;
                currentQuestion.answer = a + b;
            } else {
                a = Math.floor(Math.random() * (15 * gameDifficulty)) + 5;
                b = Math.floor(Math.random() * a); // ensure positive answer
                currentQuestion.answer = a - b;
            }
            
            currentQuestion.text = `${a} ${op} ${b}`;
            questionDisplay.innerText = currentQuestion.text;
        }

        function createBubble(isCorrect) {
            const radius = Math.random() * 20 + 50; // 50 to 70
            const x = Math.random() * (canvasElement.width - radius * 2) + radius;
            const y = canvasElement.height + radius; // Start below screen
            
            // Speed increases slightly with difficulty
            const speedY = (Math.random() * 2 + 3) * (1 + (gameDifficulty - 1) * 0.2);
            
            let value;
            if (isCorrect) {
                value = currentQuestion.answer;
            } else {
                // Generate a wrong answer close to the real one
                do {
                    let offset = Math.floor(Math.random() * 10) - 5;
                    if (offset === 0) offset = 1;
                    value = currentQuestion.answer + offset;
                } while (value === currentQuestion.answer || value < 0);
            }

            // Colors
            const colors = [
                {bg: '#ef4444', border: '#b91c1c'}, // Red
                {bg: '#10b981', border: '#047857'}, // Green
                {bg: '#f59e0b', border: '#b45309'}, // Yellow
                {bg: '#8b5cf6', border: '#5b21b6'}, // Purple
                {bg: '#ec4899', border: '#be185d'}  // Pink
            ];
            const color = colors[Math.floor(Math.random() * colors.length)];

            bubbles.push({
                x, y, radius, value, speedY, isCorrect,
                color: color.bg, borderColor: color.border,
                active: true,
                popTimer: 0 // Used for animation when sliced
            });
        }

        function spawnBubbles() {
            // Spawn 1 correct bubble and 2-3 incorrect ones
            createBubble(true);
            const wrongCount = Math.floor(Math.random() * 2) + 2;
            for(let i=0; i<wrongCount; i++) {
                createBubble(false);
            }
        }

        function createParticles(x, y, color) {
            for(let i=0; i<15; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 15,
                    vy: (Math.random() - 0.5) * 15,
                    radius: Math.random() * 6 + 2,
                    color: color,
                    life: 1.0 // 1.0 to 0.0
                });
            }
        }

        // --- NEW: Game Juice (Audio & Visual FX) ---
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
            if (audioCtx.state === 'suspended') audioCtx.resume();
        }

        function playSound(type) {
            if (!audioCtx) return;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            
            const now = audioCtx.currentTime;
            if(type === 'slice') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(800, now);
                osc.frequency.exponentialRampToValueAtTime(1200, now + 0.1);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
                osc.start(now); osc.stop(now + 0.1);
            } else if(type === 'correct') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(440, now);
                osc.frequency.setValueAtTime(554.37, now + 0.1); 
                osc.frequency.setValueAtTime(659.25, now + 0.2); 
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.3);
                osc.start(now); osc.stop(now + 0.3);
            } else if(type === 'wrong') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, now);
                osc.frequency.exponentialRampToValueAtTime(50, now + 0.3);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.3);
                osc.start(now); osc.stop(now + 0.3);
            } else if(type === 'gameover') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(200, now);
                osc.frequency.exponentialRampToValueAtTime(20, now + 1.0);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.linearRampToValueAtTime(0, now + 1.0);
                osc.start(now); osc.stop(now + 1.0);
            }
        }

        function createFloatingText(x, y, text, color) {
            floatingTexts.push({ x, y, text, color, life: 1.0, vy: -2 });
        }
        // --- END NEW ---

        function updateUI() {
            scoreDisplay.innerText = score;
            finalScoreDisplay.innerText = score;
            
            // Handle Combo display
            if (combo > 1) {
                comboDisplay.classList.remove('hidden');
                comboDisplay.innerText = `Combo x${combo}!`;
                comboDisplay.classList.add('animate-bounce');
                setTimeout(() => comboDisplay.classList.remove('animate-bounce'), 500);
            } else {
                comboDisplay.classList.add('hidden');
            }
            
            if (gameMode === 'survival') {
                livesContainer.classList.remove('hidden');
                timeContainer.classList.add('hidden');
                
                // Update Hearts
                livesDisplay.innerHTML = '';
                for(let i=0; i<3; i++) {
                    if (i < lives) {
                        livesDisplay.innerHTML += `<svg class="w-8 h-8 text-red-500 fill-current drop-shadow-md" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
                    } else {
                        livesDisplay.innerHTML += `<svg class="w-8 h-8 text-gray-600 fill-current" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>`;
                    }
                }
            } else {
                livesContainer.classList.add('hidden');
                timeContainer.classList.remove('hidden');
                timeDisplay.innerText = timeLeft + 's';
            }
        }

        function loseLife() {
            combo = 0;
            screenShake = 15;
            playSound('wrong');
            lives--;
            updateUI();
            
            // Flash screen red briefly
            const overlay = document.createElement('div');
            overlay.className = 'absolute inset-0 bg-red-600/30 z-50 pointer-events-none transition-opacity duration-300';
            document.getElementById('game-container').appendChild(overlay);
            setTimeout(() => overlay.style.opacity = '0', 50);
            setTimeout(() => overlay.remove(), 350);

            if (lives <= 0) {
                endGame();
            }
        }

        function applyTimePenalty() {
            combo = 0;
            screenShake = 15;
            playSound('wrong');
            timeLeft = Math.max(0, timeLeft - 5); // 5 second penalty for mistakes
            updateUI();
            
            // Flash screen red briefly
            const overlay = document.createElement('div');
            overlay.className = 'absolute inset-0 bg-red-600/30 z-50 pointer-events-none transition-opacity duration-300';
            document.getElementById('game-container').appendChild(overlay);
            setTimeout(() => overlay.style.opacity = '0', 50);
            setTimeout(() => overlay.remove(), 350);

            if (timeLeft <= 0) {
                endGame();
            }
        }

        function gameLoop() {
            if (gameState !== 'playing') return;

            // Clear canvas completely
            canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

            // Apply Screen Shake Effect
            canvasCtx.save();
            if (screenShake > 0) {
                const dx = (Math.random() - 0.5) * screenShake;
                const dy = (Math.random() - 0.5) * screenShake;
                canvasCtx.translate(dx, dy);
                screenShake *= 0.9;
                if (screenShake < 0.5) screenShake = 0;
            }

            // 1. Draw Video Feed (Background)
            // We draw the video feed manually onto the canvas to apply blending/effects if needed.
            if (videoElement.readyState >= 2) {
                // Calculate aspect ratio preserving dimensions
                const vRatio = (canvasElement.width / videoElement.videoWidth);
                const hRatio = (canvasElement.height / videoElement.videoHeight);
                const ratio  = Math.max(vRatio, hRatio);
                const centerShift_x = ( canvasElement.width - videoElement.videoWidth*ratio ) / 2;
                const centerShift_y = ( canvasElement.height - videoElement.videoHeight*ratio ) / 2;  
                
                canvasCtx.save();
                // Mirror the context horizontally just for the webcam feed
                canvasCtx.translate(canvasElement.width, 0);
                canvasCtx.scale(-1, 1);
                
                canvasCtx.drawImage(videoElement, 0,0, videoElement.videoWidth, videoElement.videoHeight,
                                   centerShift_x,centerShift_y,videoElement.videoWidth*ratio, videoElement.videoHeight*ratio);
                
                canvasCtx.restore();
            }

            // Darken the background slightly for better visibility
            canvasCtx.fillStyle = 'rgba(0, 0, 0, 0.4)';
            canvasCtx.fillRect(0, 0, canvasElement.width, canvasElement.height);

            // 2. Manage Bubbles
            frameCounter++;
            // Dynamically adjust spawn rate based on difficulty
            const currentSpawnRate = Math.max(60, BUBBLE_SPAWN_RATE - (gameDifficulty * 10));
            if (frameCounter >= currentSpawnRate) {
                spawnBubbles();
                frameCounter = 0;
            }

            // Handle Time Mode Clock
            if (gameMode === 'time') {
                const now = performance.now();
                if (now - lastTick >= 1000) {
                    timeLeft--;
                    lastTick = now;
                    updateUI();
                    if (timeLeft <= 0) {
                        endGame();
                        return; // Halt render logic when time ends
                    }
                }
            }

            // Update & Draw Bubbles
            for (let i = bubbles.length - 1; i >= 0; i--) {
                let b = bubbles[i];
                
                if (b.active) {
                    b.y -= b.speedY; // move up
                    
                    // Collision with trail (Slicing logic)
                    // Simple check: if index finger is inside the bubble
                    const dx = indexFingerPos.x - b.x;
                    const dy = indexFingerPos.y - b.y;
                    const distance = Math.sqrt(dx * dx + dy * dy);

                    if (distance < b.radius) {
                        b.active = false;
                        playSound('slice');
                        createParticles(b.x, b.y, b.color);
                        
                        if (b.isCorrect) {
                            // Slice Correct Answer
                            combo++;
                            const pointsEarned = 10 * combo;
                            score += pointsEarned;
                            playSound('correct');
                            createFloatingText(b.x, b.y, `+${pointsEarned}`, '#34d399'); // Green text
                            
                            gameDifficulty += 0.1; // slowly increase difficulty
                            updateUI();
                            // Clear all current bubbles to prevent accidental wrong slices immediately after
                            bubbles.forEach(bub => {
                                if(bub.active) {
                                    bub.active = false;
                                    createParticles(bub.x, bub.y, '#9ca3af'); // gray particles for the rest
                                }
                            });
                            generateQuestion(); // Next question
                        } else {
                            // Sliced Wrong Answer
                            createFloatingText(b.x, b.y, 'WRONG!', '#ef4444');
                            if (gameMode === 'survival') loseLife();
                            else applyTimePenalty();
                        }
                    }
                    
                    // Check if correct bubble went off top of screen missed
                    if (b.y + b.radius < 0) {
                        b.active = false;
                        if (b.isCorrect) {
                            // Missed correct answer!
                            if (gameMode === 'survival') loseLife();
                            // In time mode, missing is fine, it just wastes time
                        }
                    }
                }

                // Draw Bubble
                if (b.active) {
                    canvasCtx.beginPath();
                    canvasCtx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
                    
                    // Gradient fill
                    const gradient = canvasCtx.createRadialGradient(b.x - b.radius/3, b.y - b.radius/3, b.radius/10, b.x, b.y, b.radius);
                    gradient.addColorStop(0, '#ffffff'); // highlight
                    gradient.addColorStop(0.2, b.color);
                    gradient.addColorStop(1, b.borderColor);
                    
                    canvasCtx.fillStyle = gradient;
                    canvasCtx.fill();
                    
                    canvasCtx.lineWidth = 4;
                    canvasCtx.strokeStyle = 'rgba(255,255,255,0.5)';
                    canvasCtx.stroke();

                    // Draw Text inside
                    canvasCtx.fillStyle = '#ffffff';
                    canvasCtx.font = `bold ${b.radius * 0.8}px Inter, sans-serif`;
                    canvasCtx.textAlign = 'center';
                    canvasCtx.textBaseline = 'middle';
                    // Add slight drop shadow to text
                    canvasCtx.shadowColor = 'rgba(0,0,0,0.5)';
                    canvasCtx.shadowBlur = 4;
                    canvasCtx.shadowOffsetX = 2;
                    canvasCtx.shadowOffsetY = 2;
                    canvasCtx.fillText(b.value, b.x, b.y);
                    
                    // Reset shadow
                    canvasCtx.shadowColor = 'transparent';
                } else {
                    // Remove inactive
                    bubbles.splice(i, 1);
                }
            }

            // 3.5 Update & Draw Floating Texts
            for (let i = floatingTexts.length - 1; i >= 0; i--) {
                let ft = floatingTexts[i];
                ft.y += ft.vy;
                ft.life -= 0.015;

                if (ft.life <= 0) {
                    floatingTexts.splice(i, 1);
                } else {
                    canvasCtx.globalAlpha = ft.life;
                    canvasCtx.fillStyle = ft.color;
                    canvasCtx.font = '900 40px Inter, sans-serif';
                    canvasCtx.textAlign = 'center';
                    
                    canvasCtx.shadowColor = 'rgba(0,0,0,0.8)';
                    canvasCtx.shadowBlur = 10;
                    canvasCtx.shadowOffsetX = 3;
                    canvasCtx.shadowOffsetY = 3;
                    
                    canvasCtx.fillText(ft.text, ft.x, ft.y);
                    
                    canvasCtx.shadowColor = 'transparent';
                    canvasCtx.globalAlpha = 1.0;
                }
            }

            // 4. Draw Hand / Blade Trail
            if (fingerTrail.length > 1) {
                canvasCtx.beginPath();
                canvasCtx.lineCap = 'round';
                canvasCtx.lineJoin = 'round';
                
                for (let i = 0; i < fingerTrail.length; i++) {
                    const point = fingerTrail[i];
                    if (i === 0) {
                        canvasCtx.moveTo(point.x, point.y);
                    } else {
                        canvasCtx.lineTo(point.x, point.y);
                    }
                }
                
                // Blade style (glowing gradient)
                canvasCtx.shadowColor = '#60a5fa'; // tailwind blue-400
                canvasCtx.shadowBlur = 15;
                canvasCtx.lineWidth = 12;
                canvasCtx.strokeStyle = 'rgba(255, 255, 255, 0.8)';
                canvasCtx.stroke();
                
                // Inner core
                canvasCtx.shadowBlur = 0;
                canvasCtx.lineWidth = 4;
                canvasCtx.strokeStyle = '#ffffff';
                canvasCtx.stroke();
            }
            
            // Draw a dot at the current finger tip
            if (indexFingerPos.x !== -100) {
                canvasCtx.beginPath();
                canvasCtx.arc(indexFingerPos.x, indexFingerPos.y, 8, 0, Math.PI * 2);
                canvasCtx.fillStyle = '#ffffff';
                canvasCtx.fill();
                canvasCtx.shadowColor = '#60a5fa';
                canvasCtx.shadowBlur = 10;
            }

            // Clean up trail (fade effect)
            if (fingerTrail.length > 0) {
                fingerTrail.shift(); // Remove oldest point automatically if not moving
            }
            
            // Restore canvas context from screen shake
            canvasCtx.restore();

            animationFrameId = requestAnimationFrame(gameLoop);
        }

        function onResults(results) {
            if (gameState !== 'playing') return;

            // Reset finger pos if no hands detected
            if (!results.multiHandLandmarks || results.multiHandLandmarks.length === 0) {
                indexFingerPos = { x: -100, y: -100 };
                return;
            }

            // Track the first detected hand
            const landmarks = results.multiHandLandmarks[0];
            
            // Landmark 8 is the INDEX_FINGER_TIP
            const indexTip = landmarks[8];

            // Convert normalized coordinates (0-1) to Canvas coordinates
            // Since we visually mirrored the camera feed horizontally, we must invert the X 
            // position tracked by MediaPipe to align with the rendered video feed.
            const x = (1 - indexTip.x) * canvasElement.width;
            const y = indexTip.y * canvasElement.height;

            indexFingerPos = { x, y };

            // Add to trail
            fingerTrail.push({ x, y });
            if (fingerTrail.length > MAX_TRAIL_LENGTH) {
                fingerTrail.shift();
            }
        }

        const hands = new Hands({locateFile: (file) => {
            return `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`;
        }});
        
        hands.setOptions({
            maxNumHands: 1, // Only track one hand for simplicity
            modelComplexity: 1,
            minDetectionConfidence: 0.6,
            minTrackingConfidence: 0.6
        });
        hands.onResults(onResults);

        const camera = new Camera(videoElement, {
            onFrame: async () => {
                if (gameState === 'playing' || gameState === 'loading') {
                    await hands.send({image: videoElement});
                }
            },
            width: 640,
            height: 480
        });

        async function startGame(mode) {
            gameMode = mode || 'survival';
            
            startScreen.classList.add('hidden');
            gameOverScreen.classList.add('hidden');
            modeSelection.classList.add('hidden');
            if(restartButtons) restartButtons.classList.add('hidden');
            loadingText.classList.remove('hidden');
            startScreen.classList.remove('hidden'); // Show just loading text
            
            gameState = 'loading';

            try {
                // Initialize Audio Context (must be triggered by user gesture)
                initAudio();
                
                // Initialize camera
                await camera.start();
                
                // Setup Game Start State
                gameState = 'playing';
                score = 0;
                combo = 0;
                screenShake = 0;
                lives = 3;
                timeLeft = 60;
                lastTick = performance.now();
                gameDifficulty = 1;
                bubbles = [];
                particles = [];
                floatingTexts = [];
                fingerTrail = [];
                frameCounter = 0;
                
                generateQuestion();
                updateUI();
                
                startScreen.classList.add('hidden');
                uiLayer.classList.remove('hidden');
                
                // Kick off render loop
                if (animationFrameId) cancelAnimationFrame(animationFrameId);
                gameLoop();

            } catch (error) {
                console.error(error);
                loadingText.innerText = "Error accessing camera. Please ensure permissions are granted and try again.";
                loadingText.classList.replace('text-blue-300', 'text-red-400');
                modeSelection.classList.remove('hidden');
            }
        }

        function endGame() {
            gameState = 'gameover';
            playSound('gameover');
            uiLayer.classList.add('hidden');
            gameOverScreen.classList.remove('hidden');
            if(restartButtons) restartButtons.classList.remove('hidden');
            if (animationFrameId) cancelAnimationFrame(animationFrameId);
            
            // Draw a dim layer
            canvasCtx.fillStyle = 'rgba(0,0,0,0.7)';
            canvasCtx.fillRect(0, 0, canvasElement.width, canvasElement.height);
        }

        // Event Listeners
        startSurvivalBtn.addEventListener('click', () => startGame('survival'));
        startTimeBtn.addEventListener('click', () => startGame('time'));
        restartSurvivalBtn.addEventListener('click', () => startGame('survival'));
        restartTimeBtn.addEventListener('click', () => startGame('time'));

    </script>
</body>
</html>
